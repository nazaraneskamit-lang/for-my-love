<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Сюрприз для тебя! ❤️</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
            background: linear-gradient(135deg, #fff5f7 0%, #fed6e3 50%, #f3e7e9 100%);
            min-height: 100vh;
            overflow-x: hidden;
        }

        .font-handwriting {
            font-family: 'Caveat', cursive;
        }

        /* Летающие сердечки */
        .heart-particle {
            position: fixed;
            color: rgba(244, 114, 182, 0.45);
            user-select: none;
            pointer-events: none;
            animation: floatUp 8s linear infinite;
            z-index: 0;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(105vh) scale(0.5) rotate(0deg);
                opacity: 0;
            }
            20% {
                opacity: 0.85;
            }
            80% {
                opacity: 0.85;
            }
            100% {
                transform: translateY(-10vh) scale(1.2) rotate(360deg);
                opacity: 0;
            }
        }

        /* Glassmorphism карточка */
        .glass-card {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.7);
            box-shadow: 0 20px 50px rgba(244, 114, 182, 0.2);
        }

        /* Переключение шагов */
        .step-card {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .step-hidden {
            opacity: 0;
            transform: translateY(20px) scale(0.95);
            pointer-events: none;
            position: absolute;
            width: 100%;
        }

        .step-active {
            opacity: 1;
            transform: translateY(0) scale(1);
            position: relative;
            width: 100%;
        }

        /* Появление реакций */
        @keyframes popIn {
            0% { transform: scale(0.8); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        .reaction-popup {
            animation: popIn 0.3s ease-out forwards;
        }
    </style>
</head>
<body class="flex items-center justify-center p-4 relative min-h-screen overflow-y-auto">

    <div id="hearts-container"></div>

    <main class="w-full max-w-md glass-card rounded-3xl p-6 sm:p-8 relative z-10 my-auto text-center shadow-2xl">

        <!-- ================= ШАГ 1: СТАРТ ================= -->
        <div id="step-1" class="step-card step-active flex flex-col items-center">
            <div class="w-24 h-24 bg-rose-100 rounded-full flex items-center justify-center mb-6 shadow-inner animate-bounce">
                <span class="text-5xl">💌</span>
            </div>
            <h1 class="text-3xl font-bold text-rose-600 mb-3 font-handwriting text-4xl">Привет, заинька! ❤️</h1>
            <p class="text-gray-600 mb-8 leading-relaxed text-sm sm:text-base">
                Хоть мы сейчас и на расстоянии, я хочу спланировать для нас кое-что особенное... Ответишь на пару вопросов? 😉
            </p>
            <button onclick="nextStep(2)" class="w-full py-4 px-8 bg-gradient-to-r from-rose-400 to-pink-500 hover:from-rose-500 hover:to-pink-600 text-white font-semibold rounded-2xl shadow-lg hover:shadow-pink-300/50 transition-all transform hover:-translate-y-0.5 active:translate-y-0 text-lg">
                Погнали ✨
            </button>
        </div>

        <!-- ================= ШАГ 2: ИДЕАЛЬНЫЙ ВЕЧЕР ================= -->
        <div id="step-2" class="step-card step-hidden flex flex-col items-center">
            <div class="text-5xl mb-3">🌙</div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">
                Как ты представляешь наш идеальный совместный вечер?
            </h2>
            <p class="text-xs text-rose-400 font-medium mb-5">Выбери то, чего хочется больше всего 💕</p>

            <div class="w-full space-y-3">
                <button onclick="handleOption(2, 3, 'Хороший выбор, кис! 🥰')" class="w-full p-4 bg-rose-50 hover:bg-rose-100 border-2 border-rose-200 hover:border-rose-400 text-gray-700 font-medium rounded-2xl text-left transition-all flex items-center justify-between group">
                    <span>Смотреть фильм в обнимку 🍿</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">💖</span>
                </button>

                <button onclick="handleOption(2, 3, 'Романтично! Обязательно погуляем 🌊✨')" class="w-full p-4 bg-rose-50 hover:bg-rose-100 border-2 border-rose-200 hover:border-rose-400 text-gray-700 font-medium rounded-2xl text-left transition-all flex items-center justify-between group">
                    <span>Гулять вечером по набережной 🌊</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">💖</span>
                </button>

                <button onclick="handleOption(2, 3, 'Идеально! Обожаю наши разговоры 💕')" class="w-full p-4 bg-rose-50 hover:bg-rose-100 border-2 border-rose-200 hover:border-rose-400 text-gray-700 font-medium rounded-2xl text-left transition-all flex items-center justify-between group">
                    <span>Заказать вкусняшки и просто разговаривать 🍝</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">💖</span>
                </button>
            </div>

            <div id="reaction-2" class="hidden mt-4 p-3 bg-pink-100 text-pink-700 rounded-xl text-sm font-semibold border border-pink-200 reaction-popup"></div>
        </div>

        <!-- ================= ШАГ 3: ВЫБОР ФИЛЬМА ================= -->
        <div id="step-3" class="step-card step-hidden flex flex-col items-center">
            <div class="text-5xl mb-3">🎬</div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">
                Какой фильм посмотрим?
            </h2>
            <p class="text-xs text-rose-400 font-medium mb-5">Выбирай под настроение 🍿</p>

            <div class="w-full space-y-3">
                <button onclick="handleOption(3, 4, 'Запомнил! Посмеемся и пообнимаемся 🎬')" class="w-full p-4 bg-rose-50 hover:bg-rose-100 border-2 border-rose-200 hover:border-rose-400 text-gray-700 font-medium rounded-2xl text-left transition-all flex items-center justify-between group">
                    <span>Уютный ромком или комедию 😂❤️</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">✨</span>
                </button>

                <button onclick="handleOption(3, 4, 'Ооо, держимся друг за друга от страха 😱❤️')" class="w-full p-4 bg-rose-50 hover:bg-rose-100 border-2 border-rose-200 hover:border-rose-400 text-gray-700 font-medium rounded-2xl text-left transition-all flex items-center justify-between group">
                    <span>Крутой детектив или триллер 😱</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">✨</span>
                </button>

                <button onclick="handleOption(3, 4, 'Включаем то, что ты захочешь, принцесса! 👑')" class="w-full p-4 bg-rose-50 hover:bg-rose-100 border-2 border-rose-200 hover:border-rose-400 text-gray-700 font-medium rounded-2xl text-left transition-all flex items-center justify-between group">
                    <span>Твой любимый фильм, который ты выберешь ✨</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">✨</span>
                </button>
            </div>

            <div id="reaction-3" class="hidden mt-4 p-3 bg-pink-100 text-pink-700 rounded-xl text-sm font-semibold border border-pink-200 reaction-popup"></div>
        </div>

        <!-- ================= ШАГ 4: ЧТО СДЕЛАЕШЬ СЕЙЧАС ================= -->
        <div id="step-4" class="step-card step-hidden flex flex-col items-center">
            <div class="text-5xl mb-3">💭</div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">
                Что бы ты хотела сделать прямо сейчас?
            </h2>
            <p class="text-xs text-rose-400 font-medium mb-5">Честно-честно! 😁</p>

            <div class="w-full space-y-3">
                <button onclick="handleOption(4, 5, 'Обнимаю тебя крепко-крепко через все километры! 🫂✨')" class="w-full p-4 bg-pink-50 hover:bg-pink-100 border-2 border-pink-200 hover:border-pink-400 text-gray-700 font-medium rounded-2xl text-left transition-all flex items-center justify-between group">
                    <span>Сильно-сильно обнять 🫂</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">💞</span>
                </button>

                <button onclick="handleOption(4, 5, 'Лови миллион самых сладких поцелуев! 💋')" class="w-full p-4 bg-pink-50 hover:bg-pink-100 border-2 border-pink-200 hover:border-pink-400 text-gray-700 font-medium rounded-2xl text-left transition-all flex items-center justify-between group">
                    <span>Поцеловать 💋</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">💞</span>
                </button>

                <button onclick="handleOption(4, 5, 'Я бы тебя тоже скушал, ну ты и так это знаешь 😉🔥')" class="w-full p-4 bg-pink-50 hover:bg-pink-100 border-2 border-pink-200 hover:border-pink-400 text-gray-700 font-medium rounded-2xl text-left transition-all flex items-center justify-between group">
                    <span>Съесть меня ахахах 😈</span>
                    <span class="opacity-0 group-hover:opacity-100 transition-opacity">🔥</span>
                </button>
            </div>

            <div id="reaction-4" class="hidden mt-4 p-3 bg-pink-100 text-pink-700 rounded-xl text-sm font-semibold border border-pink-200 reaction-popup"></div>
        </div>

        <!-- ================= ШАГ 5: ВЫБОР ВРЕМЕНИ ================= -->
        <div id="step-5" class="step-card step-hidden flex flex-col items-center">
            <div class="text-5xl mb-3">⏰</div>
            <h2 class="text-2xl font-bold text-gray-800 mb-2">
                Какое время тебе подходит?
            </h2>
            <p class="text-xs text-rose-400 font-medium mb-5">Выбери удобный интервал 🕒</p>

            <div class="w-full space-y-3">
                <button onclick="handleOption(5, 6, 'Хороший выбор, жди сюрприз, котёнок! 🎁💖')" class="w-full p-4 bg-rose-50 hover:bg-rose-100 border-2 border-rose-200 hover:border-rose-400 text-gray-700 font-medium rounded-2xl transition-all text-center">
                    С 9:00 до 12:00 🌅
                </button>

                <button onclick="handleOption(5, 6, 'Хороший выбор, жди сюрприз, котёнок! 🎁💖')" class="w-full p-4 bg-rose-50 hover:bg-rose-100 border-2 border-rose-200 hover:border-rose-400 text-gray-700 font-medium rounded-2xl transition-all text-center">
                    С 14:00 до 16:00 ☀️
                </button>

                <button onclick="handleOption(5, 6, 'Хороший выбор, жди сюрприз, котёнок! 🎁💖')" class="w-full p-4 bg-rose-50 hover:bg-rose-100 border-2 border-rose-200 hover:border-rose-400 text-gray-700 font-medium rounded-2xl transition-all text-center">
                    С 18:00 до 21:00 🌙
                </button>
            </div>

            <div id="reaction-5" class="hidden mt-4 p-3 bg-pink-100 text-pink-700 rounded-xl text-sm font-semibold border border-pink-200 reaction-popup"></div>
        </div>

        <!-- ================= ШАГ 6: ФИНАЛ ================= -->
        <div id="step-6" class="step-card step-hidden flex flex-col items-center">
            <div class="w-20 h-20 bg-pink-100 rounded-full flex items-center justify-center mb-4 text-4xl animate-bounce">
                🎉
            </div>
            <h2 class="text-3xl font-bold text-rose-600 mb-3 font-handwriting text-4xl">
                Хороший выбор, жди сюрприз, котёнок! 🎁💖
            </h2>
            <p class="text-gray-700 font-semibold text-lg mb-4">
                Твой подарок уже готовится!
            </p>

            <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl mb-6 text-sm text-gray-600 leading-relaxed shadow-sm">
                В выбранный тобой временной интервал тебе позвонит курьер. Не забудь открыть дверь и улыбнуться! 💐✨
            </div>

            <div class="text-xs text-pink-400 font-medium">
                Люблю тебя очень сильно! ❤️
            </div>
        </div>

    </main>

    <script>
        // Генерация фоновых сердечек
        function createHearts() {
            const container = document.getElementById('hearts-container');
            const heartIcons = ['❤️', '💖', '🌸', '💕', '✨', '🌹'];
            for (let i = 0; i < 22; i++) {
                const heart = document.createElement('div');
                heart.className = 'heart-particle';
                heart.innerText = heartIcons[Math.floor(Math.random() * heartIcons.length)];
                heart.style.left = Math.random() * 100 + 'vw';
                heart.style.animationDelay = Math.random() * 8 + 's';
                heart.style.fontSize = (Math.random() * 20 + 15) + 'px';
                container.appendChild(heart);
            }
        }
        createHearts();

        let currentStep = 1;

        // Плавная смена шагов
        function nextStep(stepNumber) {
            const currentEl = document.getElementById(`step-${currentStep}`);
            const nextEl = document.getElementById(`step-${stepNumber}`);

            currentEl.classList.remove('step-active');
            currentEl.classList.add('step-hidden');

            setTimeout(() => {
                nextEl.classList.remove('step-hidden');
                nextEl.classList.add('step-active');
                currentStep = stepNumber;
            }, 300);
        }

        // Показ текста-реакции и переход дальше
        function handleOption(step, next, reactionText) {
            const reactionDiv = document.getElementById(`reaction-${step}`);
            reactionDiv.innerText = reactionText;
            reactionDiv.classList.remove('hidden');

            confetti({
                particleCount: 25,
                spread: 50,
                origin: { y: 0.8 }
            });

            setTimeout(() => {
                nextStep(next);
                if (next === 6) {
                    triggerFinalCelebration();
                }
            }, 1200);
        }

        // Финальный салют конфетти
        function triggerFinalCelebration() {
            var duration = 3.5 * 1000;
            var animationEnd = Date.now() + duration;
            var defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 100 };

            function randomInRange(min, max) {
              return Math.random() * (max - min) + min;
            }

            var interval = setInterval(function() {
              var timeLeft = animationEnd - Date.now();

              if (timeLeft <= 0) {
                return clearInterval(interval);
              }

              var particleCount = 50 * (timeLeft / duration);
              confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } }));
              confetti(Object.assign({}, defaults, { particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } }));
            }, 250);
        }
    </script>
</body>
</html>
